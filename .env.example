# Copy to .env (or set these in your host's dashboard). Only PUBLIC_URL is needed to start.
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://your-leadrush-domain.com
DATABASE_PATH=./data/leadrush.db

# First admin account (created on startup if it doesn't exist)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Twilio — turns on live inbound call routing + SMS lead alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555555555
CALL_GREETING_NAME=LeadRush

# Stripe — lets agents top up their wallet by card
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MIN_DEPOSIT_CENTS=2500
DISPUTE_WINDOW_HOURS=72
